@startuml
title Modelo Instrucional de Aprendizado - SQL JOINs


state joins{
  state conceitos_basicos{
    state apresentacao
    state exemplos
    state questoes
  }

  state conceitos_join{
    state selecionar_modulo{
      
    }

    state finalizar_modulo{

    }

    state inner_join {
      state apresentacao
      state exemplos
      state questoes
    }
    state left_join {
      state apresentacao
      state exemplos
      state questoes
    }
    state right_join {
      state apresentacao
      state exemplos
      state questoes
    }
    state full_outer_join {
      state apresentacao
      state exemplos
      state questoes
    }
  }

  state consultas_complexas {
    state apresentacao
    state exemplos
    state questoes
  }

  state apresentar_notas {

  }

' ========================================================
' Bloco 1: Conceitos e Fundamentos do JOIN
' ========================================================
  [*] --> conceitos_basicos.apresentacao: iniciarModulo
  conceitos_basicos.apresentacao --> conceitos_basicos.exemplos: concluirApresentacao
  conceitos_basicos.exemplos --> conceitos_basicos.questoes: concluirExemplos
  conceitos_basicos.questoes --> conceitos_basicos.apresentacao: respostaIncorreta
  conceitos_basicos.questoes ---> conceitos_join.selecionar_modulo: respostaCorreta

' ========================================================
' Bloco 2: Tipos de JOIN (Navegação Sequencial Educativa)
' ========================================================
' Transição módulos de join
  conceitos_join.selecionar_modulo --> conceitos_join.inner_join: selecionarInnerJoin
  conceitos_join.selecionar_modulo --> conceitos_join.left_join: selecionarLeftJoin
  conceitos_join.selecionar_modulo --> conceitos_join.right_join: selecionarRightJoin
  conceitos_join.selecionar_modulo --> conceitos_join.full_outer_join: selecionarFullOuterJoin
' Sub-bloco 2.1: Inner Join
  conceitos_join.inner_join.apresentacao --> conceitos_join.inner_join.exemplos: concluirApresentacao
  conceitos_join.inner_join.exemplos --> conceitos_join.inner_join.questoes: concluirExemplos
  conceitos_join.inner_join.questoes --> conceitos_join.inner_join.apresentacao: respostaIncorreta
  conceitos_join.inner_join.questoes -down-> conceitos_join.finalizar_modulo: respostaCorreta

' Sub-bloco 2.2: Left Join
  conceitos_join.left_join.apresentacao --> conceitos_join.left_join.exemplos: concluirApresentacao
  conceitos_join.left_join.exemplos --> conceitos_join.left_join.questoes: concluirExemplos
  conceitos_join.left_join.questoes --> conceitos_join.left_join.apresentacao: respostaIncorreta
  conceitos_join.left_join.questoes -down-> conceitos_join.finalizar_modulo: respostaCorreta

' Sub-bloco 2.3: Right Join
  conceitos_join.right_join.apresentacao --> conceitos_join.right_join.exemplos: concluirApresentacao
  conceitos_join.right_join.exemplos --> conceitos_join.right_join.questoes: concluirExemplos
  conceitos_join.right_join.questoes --> conceitos_join.right_join.apresentacao: respostaIncorreta
  conceitos_join.right_join.questoes -down-> conceitos_join.finalizar_modulo: respostaCorreta

' Sub-bloco 2.4: Full Outer Join
  conceitos_join.full_outer_join.apresentacao --> conceitos_join.full_outer_join.exemplos: concluirApresentacao
  conceitos_join.full_outer_join.exemplos --> conceitos_join.full_outer_join.questoes: concluirExemplos
  conceitos_join.full_outer_join.questoes --> conceitos_join.full_outer_join.apresentacao: respostaIncorreta
  conceitos_join.full_outer_join.questoes -down-> conceitos_join.finalizar_modulo: respostaCorreta

' Transição apresentar_notas
  conceitos_join.apresentar_notas -up-> conceitos_join.selecionar_modulo: moduloIncompleto
  conceitos_join.apresentar_notas : Estado intermediário para organização

' Transição finalizar_modulo
  conceitos_join.finalizar_modulo --up-> conceitos_join.apresentar_notas: moduloIncompleto
  conceitos_join.finalizar_modulo -down-> consultas_complexas.apresentacao: modulosCompletos
' ========================================================
' Bloco 3: Exemplos de Consultas Complexas
' ========================================================
  consultas_complexas.apresentacao --> consultas_complexas.exemplos: concluirApresentacao
  consultas_complexas.exemplos --> consultas_complexas.questoes: concluirExemplos
  consultas_complexas.questoes --> consultas_complexas.apresentacao: respostaIncorreta
  consultas_complexas.questoes --> apresentar_notas: concluirModulo

  ' Apresentação final das notas
  apresentar_notas --> [*]
}
@enduml
