@startuml
title Modelo Instrucional de Aprendizado - SQL JOINs


state joins{
  state conceitos_basicos{
    state apresentacao
    state exemplos
    state questoes
  }
  
  state inner_join {
    state apresentacao
    state exemplos
    state questoes
  }
  
  state left_join {
    state apresentacao
    state exemplos
    state questoes
  }
  
  state right_join {
    state apresentacao
    state exemplos
    state questoes
  }
  
  state full_outer_join {
    state apresentacao
    state exemplos
    state questoes
  }
  
  state consultas_complexas {
    state apresentacao
    state exemplos
    state questoes
  }
  
' ========================================================
' Bloco 1: Conceitos e Fundamentos do JOIN
' ========================================================
  [*] --> conceitos_basicos.apresentacao: iniciarModulo
  conceitos_basicos.apresentacao --> conceitos_basicos.exemplos: concluirApresentacao
  conceitos_basicos.exemplos --> conceitos_basicos.questoes: concluirExemplos
  conceitos_basicos.questoes --> conceitos_basicos.apresentacao: respostaIncorreta
  conceitos_basicos.questoes ---> inner_join.apresentacao: respostaCorreta
    
' ========================================================
' Bloco 2: Tipos de JOIN (Navegação Sequencial Educativa)
' ========================================================
' Sub-bloco 2.1: Inner Join
  inner_join.apresentacao --> inner_join.exemplos: concluirApresentacao
  inner_join.exemplos --> inner_join.questoes: concluirExemplos
  inner_join.questoes --> inner_join.apresentacao: respostaIncorreta
  inner_join.questoes --> left_join.apresentacao: respostaCorreta
  
' Sub-bloco 2.2: Left Join
  left_join.apresentacao --> left_join.exemplos: concluirApresentacao
  left_join.exemplos --> left_join.questoes: concluirExemplos
  left_join.questoes --> left_join.apresentacao: respostaIncorreta
  left_join.questoes --> right_join.apresentacao: respostaCorreta
  
' Sub-bloco 2.3: Right Join
  right_join.apresentacao --> right_join.exemplos: concluirApresentacao
  right_join.exemplos --> right_join.questoes: concluirExemplos
  right_join.questoes --> right_join.apresentacao: respostaIncorreta
  right_join.questoes --> full_outer_join.apresentacao: respostaCorreta
  
' Sub-bloco 2.4: Full Outer Join
  full_outer_join.apresentacao --> full_outer_join.exemplos: concluirApresentacao
  full_outer_join.exemplos --> full_outer_join.questoes: concluirExemplos
  full_outer_join.questoes --> full_outer_join.apresentacao: respostaIncorreta
  full_outer_join.questoes --> consultas_complexas.apresentacao: respostaCorreta
  
' ========================================================
' Bloco 3: Exemplos de Consultas Complexas
' ========================================================
  consultas_complexas.apresentacao --> consultas_complexas.exemplos: concluirApresentacao
  consultas_complexas.exemplos --> consultas_complexas.questoes: concluirExemplos
  consultas_complexas.questoes --> consultas_complexas.apresentacao: respostaIncorreta
  consultas_complexas.questoes --> [*]: concluirModulo
}

@enduml
